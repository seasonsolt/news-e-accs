# Shared settings in eacc-.service.d/common.conf.
[Unit]
Description=e/acc news web (SSR, static files, proxies api-owned paths)
After=eacc-api.service

[Service]
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=3000
ExecStart=/opt/node24/bin/node apps/web/server.ts

[Install]
WantedBy=multi-user.target
