# Shared settings in eacc-.service.d/common.conf.
[Unit]
Description=e/acc news worker (collection, model calls, reports)
After=eacc-api.service
Requires=postgresql.service

[Service]
ExecStart=/opt/node24/bin/node apps/worker/src/main.ts
# Let a paid call in flight finish on stop (STOP_TIMEOUT_MS is 195 s), or it is paid for again.
TimeoutStopSec=210

[Install]
WantedBy=multi-user.target
